# ===== GradTrack — ตัวอย่างค่า environment =====
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit .env — .gitignore กันไว้แล้ว)
#
# บน production ค่าเหล่านี้ตั้งที่ "stack env" ของ Portainer ไม่ใช่ไฟล์บนดิสก์
# ตัวที่ docker-compose.yml บังคับ (ไม่ตั้ง = stack ไม่ขึ้น พร้อมบอกเหตุผล):
#   GRADUATE_DB_PASSWORD · JWT_SECRET · SCHOOLOS_API_KEY

# ----- PostgreSQL -----
# GradTrack ไม่สร้าง container db เอง — ไปเกาะ postgres-core บน network "school-net"
# (role/db ชื่อ graduate ถูกสร้างไว้แล้วโดยสแตก postgres-core)
GRADUATE_DB_HOST=postgres-core
GRADUATE_DB_PORT=5432
GRADUATE_DB_USER=graduate
GRADUATE_DB_PASSWORD=CHANGE_ME
GRADUATE_DB_NAME=graduate

# ต่อ DB ตอน dev บน host — docker compose ประกอบค่านี้ให้เองจากตัวแปรข้างบน
# (บน host ใช้ localhost:5432 เพราะ postgres-core publish พอร์ตออกมา)
DATABASE_URL=postgres://graduate:CHANGE_ME@localhost:5432/graduate

# ----- JWT -----
# สุ่มค่ายาว ๆ เช่น `openssl rand -hex 32`
#
# ⚠️  ห้ามเปลี่ยนพร่ำเพรื่อ: เปลี่ยนแล้ว token ที่ออกไปแล้วใช้ไม่ได้ทั้งหมด
#     ทุกคน (ครู + นักเรียน) หลุดจากระบบพร้อมกันและต้องล็อกอินใหม่
#     — ข้อมูลไม่หาย แต่เจอพร้อมกันทั้งโรงเรียนตอนเช้าวันจันทร์ไม่สนุก
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# อายุ token · รูปแบบ: '30m' · '8h' · '7d' (ตัวเลขเปล่า = วินาที)
# 8h = ครบวันทำงานพอดี ล็อกอินเช้าใช้ได้ทั้งวัน
#
# ไม่ใช่เพดานแข็ง — ใกล้หมดแล้วถ้าผู้ใช้ยังนั่งทำงานอยู่จริง หน้าเว็บจะขอต่ออายุให้เอง
# (POST /api/auth/refresh) ไม่งั้นครูที่กรอกข้อมูลค้างอยู่จะถูกเตะออกกลางคันแล้วข้อมูลหาย
#
# ตัวที่คุมจริงคือ idle timeout — ไม่แตะหน้าจอ 15 นาทีแล้วหลุด
# ตัวนั้นอยู่ฝั่งหน้าเว็บ (client/src/utils/session.js) แก้ที่โค้ด ไม่ใช่ที่นี่
JWT_EXPIRES_IN=8h

# ----- SchoolOS Public API -----
# base = http://<host>:3002  (ไม่ต้องมี /api/public/v1 — client เติมให้เอง)
SCHOOLOS_API_BASE=http://192.168.200.56:3002
# key เดียวหลาย scope — ต้องมีอย่างน้อย:
#   students:read, teachers:read, auth:students, auth:teachers
# ถ้าจะเปิดทางล็อกอินเดิม "Skdw+เลขบัตรประชาชน" ต้องมี students:pii เพิ่ม
# silent SSO (ข้างล่าง) ต้องมี auth:handoff เพิ่ม
# (entrypoint ตรวจ scope ให้ตอนสตาร์ท — ขาดตัวไหนจะบอกชื่อ scope นั้นตรง ๆ)
SCHOOLOS_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# ----- Silent SSO (ล็อกอิน SchoolOS ไว้แล้ว = เข้า GradTrack ได้เลย) -----
# 1/ไม่ตั้ง = เปิด · 0 = ปิด (ทุกคนกรอกรหัสเองเหมือนเดิม)
SSO_SILENT_LOGIN=1
#
# ที่อยู่ SchoolOS "ในสายตาเบราว์เซอร์" — คนละตัวกับ SCHOOLOS_API_BASE ข้างบน
# ซึ่งเป็นที่อยู่ภายในที่ server ใช้ (เบราว์เซอร์ของครูอาจเข้าถึงไม่ได้ด้วยซ้ำ)
#
# prod อยู่โดเมนเดียวกัน (schoolos.sukhon.ac.th/users) จึงใส่เป็น path ล้วน = same-origin
# ไม่ต้องพึ่ง CORS · ถ้าย้ายไปคนละโดเมนให้ใส่ URL เต็ม แล้วแจ้งผู้ดูแล SchoolOS
# เพิ่ม origin ของ GradTrack ใน SSO_ALLOWED_ORIGINS (ต้องตรงเป๊ะ ห้ามมี / ปิดท้าย)
SCHOOLOS_WEB_BASE=/users
#
# ชื่อ "ระบบปลายทาง (audience)" ที่ผู้ดูแล SchoolOS ตั้งไว้ให้ key ใบนี้ — ต้องตรงเป๊ะ
# ไม่ตรง/ไม่ได้ตั้ง = แลกโค้ดไม่ได้เลย (audience_mismatch / key_audience_unset)
# ตรวจของจริงได้ที่:  curl -H "X-API-Key: sk_live_..." <base>/api/public/v1/me
SCHOOLOS_HANDOFF_AUDIENCE=grad
#
# ที่ที่ผู้ใช้จะถูกส่งไปเมื่อไม่มี session — "/" = หน้าแรกของโดเมนเดียวกัน = SchoolOS
# (prod อยู่ที่ schoolos.sukhon.ac.th/grad ดังนั้น "/" = schoolos.sukhon.ac.th พอดี)
#
# ใช้ทั้งสองทาง:
#   · กดปุ่ม "ออกจากระบบ" → ออกจาก SchoolOS ทั้งแพลตฟอร์มด้วย แล้วมาจบที่นี่
#   · session จบเอง (หมดเวลา / token หมดอายุ / 401) หรือเปิด /grad ตรง ๆ โดยไม่มี
#     session → ส่งมาที่นี่เฉย ๆ ไม่ได้เตะออกจาก SchoolOS ด้วย
#
# ควรเป็น path เสมอ — ตอนล็อกเอาต์ค่านี้ถูกส่งไปเป็น ?next= ให้ SchoolOS ซึ่งรับเฉพาะ
# path ในโดเมนตัวเอง หรือ origin ที่อยู่ใน SSO_ALLOWED_ORIGINS (กัน open redirect)
SCHOOLOS_PORTAL_URL=/

# ----- การล็อกอินของนักเรียน -----
# ทางหลัก = รหัสผ่าน SchoolOS ของนักเรียนเอง (ผ่าน /auth/verify)
# 1 = เปิดทางเดิม "Skdw" + เลขบัตรประชาชน ไว้ด้วย (ต้องมี scope students:pii)
# 0 = ปิด — แนะนำให้ตั้ง 0 เมื่อนักเรียนย้ายไปใช้รหัสผ่าน SchoolOS กันครบแล้ว
#     เพราะรหัสผ่านที่เดาได้จากเลขบัตรประชาชนไม่ปลอดภัย
STUDENT_LEGACY_LOGIN=1

# ----- subpath ที่เสิร์ฟ -----
# ถูก bake ตอน `vite build` → แก้แล้วต้อง build ใหม่ (เปลี่ยนตอน runtime ไม่ได้)
# prod: /grad  (nginx portal ส่ง 192.168.200.56/grad/... มาที่พอร์ตนี้ "โดยคง prefix")
# ค่าว่าง = เสิร์ฟที่ root — เหมาะกับตอนเทสในเครื่อง
# หมายเหตุ: docker-compose.yml มี default /grad ให้อยู่แล้วถ้าไม่ได้ตั้งตัวแปรนี้เลย
#
# ⚠️  nginx ต้อง "คง prefix" ไว้ — ฝั่ง proxy ต้องเป็น
#         location /grad/ { proxy_pass http://127.0.0.1:3003; }   ← ห้ามมี / ปิดท้าย
#     ถ้าใส่ / ปิดท้าย (proxy_pass .../) nginx จะตัด /grad ทิ้งก่อนส่งมา
#     แล้ว express ที่ mount ไว้ใต้ /grad จะตอบ 404 ทั้งหน้า ทั้งที่ container ปกติดี
BASE_PATH=/grad

# ----- อื่น ๆ -----
PORT=3003
# จำนวน proxy hop ที่เชื่อ X-Forwarded-For (nginx portal = 1)
# ผิดค่านี้ = rate limit ตอน login นับ IP ของ proxy → ทั้งโรงเรียนใช้โควตาถังเดียวกัน
TRUST_PROXY_HOPS=1
# ใช้เฉพาะตอน dev ที่ vite dev server อยู่คนละพอร์ต (prod เป็น same-origin ไม่ต้องใช้)
CORS_ORIGINS=http://localhost:5173

# ----- สำรอง/กู้คืนข้อมูล -----
# หน้า "สำรอง/กู้คืนข้อมูล" (admin เท่านั้น) สร้างไฟล์ .tar.gz เก็บไว้บน server
# ข้างในมีข้อมูลทุกตาราง + ไฟล์ใน uploads (ไม่มีค่าใน .env และไม่มีข้อมูลจาก SchoolOS)
#
# เก็บไฟล์ที่ระบบสร้างเองไว้กี่ไฟล์ ที่เกินถูกลบตอนสำรองครั้งถัดไป (0 = ไม่ลบเลย)
# ไฟล์ที่แอดมินอัปโหลดเข้ามาเอง และไฟล์ที่ระบบสร้างให้ก่อนกู้คืน ไม่ถูกนับ/ไม่ถูกลบ
BACKUP_KEEP=20
# ขนาดสูงสุดของไฟล์สำรองที่อัปโหลดกลับเข้ามาได้ (MB)
BACKUP_MAX_UPLOAD_MB=1024
# ที่เก็บไฟล์สำรอง — ปกติไม่ต้องตั้ง (ค่าเริ่มต้น server/backups ซึ่ง compose mount
# named volume "gradtrack-backups" ไว้ให้แล้ว → ไฟล์ไม่หายตอน redeploy)
#BACKUP_DIR=/app/server/backups

# ----- คลังมหาวิทยาลัย (seed) -----
# ตอนสตาร์ท ถ้าตาราง universities ว่างเปล่า จะลงคลังมหาวิทยาลัย/คณะ/หลักสูตร/โลโก้
# จาก server/database/seeds/ ให้อัตโนมัติ (ไม่ลบของเดิม ไม่ทับของที่แอดมินแก้ไว้)
# off = ปิด — ใช้ตอนอยากเริ่มจากคลังว่าง ๆ เอง
#CATALOG_SEED=off

# ----- admin local สำหรับกรณีฉุกเฉิน (optional) -----
# ปกติ "ไม่ต้องใช้": ผู้ดูแลมาจาก role teacher-admin ของ SchoolOS โดยตรง
# มีไว้เป็นทางเข้าสำรองตอน SchoolOS ล่ม — ต้องสั่งรันเอง ไม่รันอัตโนมัติตอน deploy
#   docker compose --profile seed run --rm seed
# ถ้าค่ามี # ต้องครอบด้วย "..."
#SEED_ADMIN_USERNAME=admin
#SEED_ADMIN_PASSWORD="CHANGE_ME"

# ----- ไม่ใช้ในระบบนี้ -----
# FIELD_ENCRYPTION_KEY: GradTrack ไม่ได้เข้ารหัสข้อมูลระดับฟิลด์ จึงไม่ต้องตั้ง
# แต่ถ้าวันหนึ่งมีการตั้งไว้ (copy .env มาจากระบบอื่น / เพิ่มฟีเจอร์เข้ารหัสทีหลัง)
# ⚠️  ห้ามเปลี่ยนค่าเด็ดขาดเมื่อมีข้อมูลเข้ารหัสอยู่แล้ว — ถอดกลับไม่ได้อีกเลย
#     backup ของ DB ก็กู้ไม่ได้ เพราะข้อมูลที่ backup ไว้ก็เข้ารหัสด้วยคีย์เดิม
#FIELD_ENCRYPTION_KEY=
